# コピーして .env を作成し、各値を埋める
# .env は gitignore 済み
#
# 取得元:
#   CLOUDFLARE_API_TOKEN  : https://dash.cloudflare.com/profile/api-tokens で発行
#                           (Account: Pages Edit, Workers KV Edit, Workers Scripts Edit)
#   CLOUDFLARE_ACCOUNT_ID : ダッシュボード右サイドバーの "Account ID"
#   CF_KV_NAMESPACE_ID    : npx wrangler kv namespace list で確認

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

CF_PAGES_PROJECT=warikan-kun
CF_PAGES_URL=https://warikan-kun.pages.dev

CF_KV_NAMESPACE_ID=
CF_KV_NAMESPACE_TITLE=warikan-kun-rooms

# --- デプロイ手順 ---
#   set -a; source .env; set +a
#   npx wrangler@4 pages deploy . --project-name=$CF_PAGES_PROJECT --branch=main --commit-dirty=true
#
# --- KV 操作例 ---
#   npx wrangler@4 kv key list --namespace-id=$CF_KV_NAMESPACE_ID
#   npx wrangler@4 kv key get "room:<id>" --namespace-id=$CF_KV_NAMESPACE_ID
#   npx wrangler@4 kv key delete "room:<id>" --namespace-id=$CF_KV_NAMESPACE_ID
